<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PersonalRecorder — lab build (visible + consent-based)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="ws:// or wss:// — your relay server"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connect to server" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disconnect" />

        <Button
            android:id="@+id/btnProjection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start screen capture (auto every 2s, diff-aware)" />

        <Button
            android:id="@+id/btnCaptureNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture screenshot now" />

        <Button
            android:id="@+id/btnStopCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop screen capture" />

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record screen + mic (MP4): start / stop" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ambient audio: start / stop" />

        <Button
            android:id="@+id/btnLoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location stream: start / stop" />

        <Button
            android:id="@+id/btnDeviceAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture device media audio (WAV): start / stop" />

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>